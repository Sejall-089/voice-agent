node_modules/
out/
dist/
.env
*.log
.claude/

# Recon output — generated WAVs from scripts/tts-recon.mjs, never committed.
tts-recon-out/

# Recon output — captured frames from scripts/screen-recon.mjs and the marked-up HTML from
# scripts/vision-recon.mjs. These are PICTURES OF THE SCREEN: never committed, and the scripts
# delete them by default (screen-recon keeps them only with --keep).
screen-recon-out/
vision-recon-out/

# Recon output — captured Spotify API responses from scripts/spotify-recon.mjs. Never
# committed: tokens are redacted on the way to disk, but the bodies still carry account
# details (country, device names, what was playing).
spotify-recon-out/

# Recon output — captured Linear MCP responses from scripts/linear-recon.mjs. Never committed:
# the key is never written, but the bodies hold the titles and descriptions of real issues.
linear-recon-out/

# Recon output — captured GitHub MCP responses from scripts/github-recon.mjs. Never committed:
# the token is never written, but the bodies hold the account's login and real issue text.
github-recon-out/
