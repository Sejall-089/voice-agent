# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Used from later milestones (M1 planner, M5 Slack). Not required for M0.
# LLM_PROVIDER selects which client the factory builds: "anthropic" or "openai".
# Only the API key for the CHOSEN provider is required.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# --- Voice input. Optional: leave blank and the bar never opens the microphone. ---
# Local transcription via whisper.cpp — nothing is sent to a cloud STT service.
#   1. Binary: download a prebuilt Windows release from
#      https://github.com/ggml-org/whisper.cpp/releases and point at whisper-cli.exe
#   2. Model:  download a ggml model, e.g. ggml-base.en.bin, from
#      https://huggingface.co/ggerganov/whisper.cpp/tree/main
# Use full absolute paths.
WHISPER_EXE_PATH=
WHISPER_MODEL_PATH=
# Language passed to whisper's -l flag. "auto" lets whisper detect it.
WHISPER_LANGUAGE=en
# Optional: pin the one hotkey. Left blank, the app claims the first FREE combo from
# Ctrl+Shift+Space → Ctrl+Alt+Space → Ctrl+Alt+M → Alt+Shift+Space and logs which it got.
# (Ctrl+Alt+Space is taken by the Microsoft IME on some Windows installs.)
HOTKEY=

# --- System-wide dictation (M12). Requires WHISPER_EXE_PATH/WHISPER_MODEL_PATH above — voice
# off means dictation is off too, since there is no separate transcription path. Hold nothing:
# tap the hotkey to start listening, tap it again to stop and type the transcript into
# whatever window currently has focus, in ANY app. Never goes through the planner. ---
# Optional: pin the dictation hotkey. Left blank, the app claims the first FREE combo from
# Ctrl+Shift+Alt+D → Ctrl+Alt+D → Ctrl+Alt+J and logs which it got. Deliberately NOT
# Ctrl+Alt+V (Excel's Paste Special) or Alt+Shift+D (Word's insert-date field) — both are
# real, common conflicts in exactly the apps dictation is most likely used in.
DICTATE_HOTKEY=

# --- Gmail reply tools (M10). Optional: leave blank and they are never offered at all. ---
# DOM-based control of Gmail in Chrome, over the Chrome DevTools Protocol — no screenshots,
# no coordinate clicking. Chrome must be started with remote debugging AND a dedicated
# profile directory: since Chrome 136 the debugging port is refused on the default profile.
#
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\voice-agent-chrome"
#
# Sign in to Gmail once in that window (a test account first — sendReply really does send).
CHROME_DEBUG_URL=http://127.0.0.1:9222
